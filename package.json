{
  "name": "fitness",
  "version": "0.0.0",
  "scripts": {
    "start": "node --import tsx src/tracker.ts",
    "dev": "tsx watch src/tracker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "author": "M. G. Pavan Kumar",
  "license": "MIT",
  "description": "User profile and workout tracker in TypeScript",
  "dependencies": {
    "uuid": "^11.1.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "5.8.2",
    "tsx": "4.20.6",
    "@types/node": "^22.13.10"
  }
}
